# Copy to .env and fill in values. .env is gitignored.

# --- API (apps/api) ---
API_PORT=4000
DATABASE_URL=postgres://crashpad:crashpad_dev@localhost:5432/crashpad
REDIS_URL=redis://localhost:6379
BETTER_AUTH_SECRET=change_me_to_a_32_byte_random_string
# Public-facing web origin. Auth requests are proxied through the Next.js
# rewrite in apps/web/next.config.mjs so the session cookie lands on the web
# origin. better-auth uses this to construct the GitHub OAuth redirect_uri.
BETTER_AUTH_URL=http://localhost:3000
WEB_URL=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GitHub OAuth App callback URL must be set to:
#   http://localhost:3000/api/auth/callback/github

# --- "Fix it" GitHub App (apps/api) ---
# All optional. Leave blank and Fix it is unavailable; nothing else changes.
# The App needs actions:write + contents:read and nothing more.
GITHUB_APP_ID=
# PKCS#1 PEM from the App's settings page. .env cannot hold real newlines, so
# either paste it on one line with \n escapes or keep it quoted and multi-line.
GITHUB_APP_PRIVATE_KEY=
# The App's URL slug, used to build the "install on a repository" link.
GITHUB_APP_SLUG=
# Where a GitHub Actions runner can reach this API to fetch a brief. Must be
# publicly resolvable for a real run — localhost only works for local tests.
PUBLIC_API_URL=http://localhost:4000

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Dogfood SDK config (when Crashpad monitors Crashpad) ---
NEXT_PUBLIC_CRASHPAD_API_KEY=
NEXT_PUBLIC_CRASHPAD_RELEASE=dev
NEXT_PUBLIC_CRASHPAD_ENVIRONMENT=development

# --- Local development convenience ---
# Set to 1 to expose GET /api/v1/dev/login, which mints a 30-day session for an
# existing user and redirects to the dashboard, skipping the GitHub round-trip.
# The route is not mounted unless NODE_ENV is not production AND this is 1.
DEV_LOGIN=
# Which account dev login signs in as. Defaults to the owner of the most
# recently created project, then to any user, then to a created dev@crashpad.local.
DEV_LOGIN_EMAIL=
