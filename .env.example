# Copy to .env and fill in values. .env is gitignored.

# --- API (apps/api) ---
API_PORT=4000
DATABASE_URL=postgres://crashpad:crashpad_dev@localhost:5432/crashpad
REDIS_URL=redis://localhost:6379
JWT_SECRET=change_me_to_a_32_byte_random_string
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT=http://localhost:4000/api/v1/auth/github/callback

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Dogfood SDK config (when Crashpad monitors Crashpad) ---
NEXT_PUBLIC_CRASHPAD_API_KEY=
NEXT_PUBLIC_CRASHPAD_RELEASE=dev
NEXT_PUBLIC_CRASHPAD_ENVIRONMENT=development
